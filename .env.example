# wow-addon-dev — EXAMPLE VALUES ONLY. Copy to .env to override; .env is gitignored.
# Nothing here is secret: the server reads only public upstream data.

# Where upstream clones and index.sqlite live (default ~/data/wow-api)
WOWDEV_DATA=/home/jim/data/wowdev
# Lua 5.1 interpreter used to evaluate Blizzard's data tables at build time
WOWDEV_LUA=lua5.1
